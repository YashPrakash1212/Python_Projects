"    start=start_date,\n","    end=end_date,\n","    auto_adjust=True,   # adjusts for dividends/splits\n","    progress=False\n",")[\"Close\"]\n","\n","data = data.dropna(how=\"all\").ffill()  # handle occasional missing trading days\n","\n","\n","normalized = data / data.iloc[0] * 100\n","\n","# Plot\n","\n","plt.figure(figsize=(14, 8))\n","\n","for ticker in TICKERS:\n","    plt.plot(normalized.index, normalized[ticker], label=ticker, linewidth=1.5, alpha=0.85)\n","\n","# Plot S&P 500 as a bold black reference line\n","plt.plot(normalized.index, normalized[BENCHMARK], label=\"S&P 500\",\n","          color=\"black\", linewidth=2.8)\n","\n","plt.title(f\"Stock Performance vs S&P 500 — Last {YEARS_BACK} Years (Normalized to 100)\",\n","          fontsize=14, fontweight=\"bold\")\n","plt.xlabel(\"Date\")\n","plt.ylabel(\"Normalized Price (Start = 100)\")\n","plt.legend(loc=\"upper left\", ncol=2, fontsize=9)\n","plt.grid(True, alpha=0.3)\n","plt.tight_layout()\n","\n","output_path = \"stock_vs_sp500.png\"\n","plt.savefig(output_path, dpi=150)\n","print(f\"Chart saved to {output_path}\")\n","plt.show()\n","\n","# ---- Summary table: total return over the period -------------------------\n","\n","total_return = (normalized.iloc[-1] - 100).sort_values(ascending=False)\n","print(\"\\nTotal return over the period (%):\")\n","print(total_return.round(2))"]}]}