lue', linestyle='--', linewidth=1, label='Target')\n","\n","    # Add score values on top of the bars\n","    for bar in bars:\n","        yval = bar.get_height()\n","        ax.text(bar.get_x() + bar.get_width()/2, yval + 2, round(yval, 2), ha='center', va='bottom', fontsize=10)\n","\n","    # Remove Y-axis ticks and labels for cleaner look, but keep the student name as label\n","    ax.set_yticks([])\n","\n","    # Only add legend once\n","    if i == 0:\n","        ax.legend(loc='upper right', bbox_to_anchor=(1.15, 1))\n","\n","plt.xlabel('Subjects', fontsize=12)\n","plt.xticks(rotation=45, ha='right')\n","plt.tight_layout(rect=[0, 0.03, 1, 0.88]) # Adjust layout to make space for suptitle\n","plt.savefig('report_card.png')\n","plt.show()\n","print(\"Report card saved as 'report_card.png'\")"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Report card saved as 'report_card.png'\n"]}]}]}